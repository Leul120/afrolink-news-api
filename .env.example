# ----------------------------------------------------------------------------
# Afrolink News API — environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# ----------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection string used by Prisma.
# Matches the credentials in docker-compose.yml out of the box.
DATABASE_URL=postgresql://afrolink:afrolink@localhost:5432/afrolink_news?schema=public

# Redis connection — powers the BullMQ job queue AND the read de-duplication.
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=24h

# Read tracking: a reader/guest generates at most one ReadLog per article
# within this window (seconds). Prevents refresh-spam (see README "Bonus").
READ_DEDUP_TTL_SECONDS=600

# Cron expression for the daily analytics aggregation job. Evaluated in UTC/GMT.
# Default: 00:05 every day.
ANALYTICS_CRON=5 0 * * *

# Run the BullMQ worker inside the API process (handy for local dev).
# In production set this to `false` and run `npm run worker` separately.
RUN_WORKER_IN_PROCESS=true
